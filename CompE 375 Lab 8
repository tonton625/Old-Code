void delay(int s){
      while (s > 0) 
        s--;
}

void dot(){
	GPIOC->ODR |= 0x01<<8; //turns on LED
	delay(2*m); //one dot
	GPIOC->ODR &= ~(0x01<<8);
	delay(2*m);
}

void dash(){
	GPIOC->ODR |= 0x01<<8; //turns on LED
	delay(6*m); //one dash
	GPIOC->ODR &= ~(0x01<<8);
	delay(2*m);	
}

void space(){
	GPIOC->ODR &= ~(0x01<<8); //turns off LED
	delay(4*m); //for 3 units
}

void wordspace(){
	GPIOC->ODR &= ~(0x01<<8); //turns off LED
	delay(8*m); //for 7 units
}
