int main(void){
	sei();
	
	DDRB |= (1 << DDB5); //output
	
	TCCR0A |= (1 << WGM01); //CTC mode
	TCCR0B |= (1 << CS02) | (1 << CS00); //1024
	TIMSK0 |= (1 << OCIE0B) | (1 << OCIE0A); //ISR
	
	OCR0A = 0x4e; //flag a
	
	uint8_t memData = eeprom_read_byte((uint8_t*) 45);
	
	if (memData < 0 || memData > 10){
	eeprom_update_byte((uint8_t*) 45, (uint8_t) 1);
	Duty = 0;
	}
	
	else{
	Duty = memData;	
	eeprom_update_byte((uint8_t*) 45, (uint8_t)(memData + 1));
	}
	
	OCR0B = Duty;
	while (1){}
}
