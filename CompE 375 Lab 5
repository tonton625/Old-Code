				while (((TIFR0 & (1<< OCF0A)) == 0) && (!(PINB & (1 <<PINB7))));
				TIFR0 |= (1 << OCF0A); //reset overflow 
				
				OCR0B += 0x08;
			}
			while (!(PINB & (1 << PINB7))){
				PORTB |= (1 << PORTB5) ;
			}
		}
		
		//TURN OFF LED WITH LAG
		if (OCR0B >= 0x08)
		{
			OCR0A = 0x9C; //represents 10ms timer (total time)
			
			while (OCR0B > 0x08)
			{
				TCCR0A |= (1 << WGM01); //Set timer to CTC
				
				PORTB |= (1 << PORTB5); //Turn on LED
				TCCR0B |= (1 << CS02) | (1 << CS00); //set pre-scaler
				while (((TIFR0 & (1<< OCF0B)) == 0)); //checking for over flow
				
				TIFR0 |= (1 << OCF0B); //reset overflow
				PORTB &= ~(1 << PORTB5); //Turn off LED
				
				while (((TIFR0 & (1<< OCF0A)) == 0) );
				TIFR0 |= (1 << OCF0A); //reset overflow
				
				if (OCR0B <= 0x10)	 
				{OCR0B = 0x08;}
				else				 
				{OCR0B -= 0x08;}
			}	
		}
		else {PORTB &= ~(1 << PORTB5);}
	}
}
		
