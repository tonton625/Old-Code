float TON(int d)
{
	float Period = 1.0/(440.0 * (pow(pow(2.0,(1.0/12.0)),d)));
	Period = Period * 10000.0;
	return Period;
}

void scan_keypad(){
	for(int i = 4; i < 8; i++) //scan matrix
	{
		PORTD &= ~(1 << i); //set rows to low
		for (int j = 0; j < 4; j++) //scan columns
		{
			if(!(PINB & (1 << j))) //when the button is pressed
			{
				int d;
				d = TON(keychar[i-4][j]);
				pwm(d);
				
				//CHECKPOINT
				//PORTC |= (1<<PORTC5);
				//lag(d);
				//PORTC &= ~(1<<PORTC5);
				//lag(d);
			}
		}
		PORTD |= (1<<i);
	}
}


	int main(void)
	{
		//uart_init();
		DDRD = 0b11110000; //set PORTD4-7 as output (1) (rows)
		DDRB = 0b00000000; // set PORTB0-4 as inputs (0) (columns)
		
		DDRB &= ~(1<<DDB0 | 1<<DDB1 | 1<<DDB2 |1<<DDB3); //column = inputs
		PORTB |= (1<<0) | (1<<1) | (1<<2) | (1<<3); //pull ups
		DDRD |= (1<<4 | 1<<5 | 1<<6 |1<<7); //rows are outputs
		PORTD |= (1<<4) | (1<<5) | (1<<6) | (1<<7);
		
	   TCCR0B |= (1<<CS02) | (1<<CS00); //1024
	   TCCR0A |= (1 << WGM00) | (1 << WGM01);//Fast PWM Mode
