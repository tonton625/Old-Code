ISR(ADC_vect){
	uint16_t variable = ADC; //unsigned integer called variable that holds ADC
	int a = variable;		//passed to OCR1B
	PINC ^= (1 << 1);		//toggle the pin
}

ISR(TIMER0_COMPA_vect){ //timer 0, adc conversion
	OCR2B = OCR2A * adc_read(PORTC1) /1024.0;     //input from Pin C is added to the equation 
}

ISR(TIMER2_COMPA_vect){ //Compare vector A in timer 2 that turns the led on
	if(OCR2B > 0){
	PORTB |= (1<<PORTB5);
	}
}

ISR(TIMER2_COMPB_vect){ //Compare vector B in timer 2 that turns the led off
	PORTB &= ~(1<<PORTB5);
}
