void adc_init(void){
	DDRC &= ~(1<<PINC1); //Setting PIN1 in PORT C as an input
	ADMUX |= (1<<REFS0) | (1<<MUX1) | (1<<MUX0); //Vcc reference. voltage
	ADCSRA |= (1<<ADEN) | (1<<ADATE) | (1<<ADIE) | (1<<ADPS1) | (1<<ADPS0); //ADC enable,ADC auto trig,ADC interrupt,division factor 8
	ADCSRB |= (1<<ADTS0) | (1<<ADTS1); // compare match A
}
float adc_read(uint16_t ch) {
	// select the corresponding channel 0~7
	ch &= 0b00000111;
	ADMUX = (ADMUX & 0xF8)|ch;// clears the bottom 3 bits before ORing
	ADCSRA |= (1<<ADSC);
	while(ADCSRA & (1<<ADSC));
	return (ADC);
}
