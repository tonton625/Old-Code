
#define F_CPU 16000000UL					// 16MHz clock
#define BAUD 9600							// define baud
#define BAUDRATE ((F_CPU)/(BAUD*16UL)-1)	// set baud rate
#include <avr/io.h>
#include <stdlib.h>
#include <math.h>
#include <avr/interrupt.h>

void key_timer(int key){
	TCCR0A |= (1 << WGM01);					//Timer mode to CTC
	OCR0A = 0x4D;							//after calculating with my RedID (3)
	OCR0B = (77*(key*1.0/10))	;			//modulated duty cycle
	TCCR0B |= (1 << CS02);					//Set pre-scaler to 256, start timer
	TIMSK0 |= (1 << OCIE0A) | (1 << OCIE0B); //set the ISR comparison vector
	return;
}

void setup(){					//for the keypad
	TCCR2A |= (1 << WGM21);		//Timer mode to CTC
	OCR2A = 0xD9;				//After calculating with my RedID number (6)
	TCCR2B |= (1 << CS22);		//set prescale to 256
	TIMSK2 |= (1 << OCIE2A | 1 << OCIE2B);
}

void scan_keypad(){
	int keypad[4][4] = {{1,2,3,0},
	{4,5,6,0},
	{7,8,9,0},
	{0,0,0,0}};
	
	int x = 0;
	for (int i = 0; i <= 3; i++){
		PORTD |= (1<<4 | 1<<5 | 1<<6 | 1<<7);			//Set all rows (output) high
		PORTD &= ~(1 << (i + 4));					//Set row(i) low one at a time
		for (int j = 0; j <= 3; j++){
			if (!(PINB & (1 << j))){				//Check each column (j) to see which is pulled low
				x = keypad[i][j];
				key_timer(x);
			}
		}
	}
}

ISR (TIMER2_COMPA_vect){
	scan_keypad();			//timer for keypad
}
ISR(TIMER0_COMPA_vect){
	PORTB |= (1 << 5);		//LED ON
}
ISR(TIMER0_COMPB_vect){
	PORTB &= ~(1 << 5);		//LED OFF
}


int main(void)
{	
	/* Declare rows D4-D7 as outputs and columns B0-B3 as inputs */
	DDRD |= (1 << DDD4 | 1 << DDD5 | 1 << DDD6 | 1 << DDD7);
	DDRB &= ~(1 << DDB0 | 1 << DDB1 | 1 << DDB2 | 1 << DDB3);
	
	PORTB |= (1 << PORTB0 |1 << PORTB1 | 1 << PORTB2 | 1 << PORTB3); //Set inputs as pullup resistors 
	DDRB |= (1 << DDB5);
	DDRB &= ~(1 << DDB7);
	PORTB |= (1 << PORTB7);		//Enable switch as pullup resistor

	cli(); //cli clears the global interrupt flag in SREG to prevent any form of interrupts occurring
	sei();
	
	setup();
    while (1) {}
}

